{
  "name": "aether",
  "version": "0.1.0",
  "private": true,
  "description": "Adaptive Event-driven Trusted Human-Environment for Real-time collaboration",
  "author": "Your Name",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "corepack pnpm --dir packages/shared-types run build && corepack pnpm --dir apps/api run build && corepack pnpm --dir apps/web run build",
    "test": "corepack pnpm --dir apps/api run test && corepack pnpm --dir apps/web run test",
    "test:ci": "corepack pnpm --dir packages/shared-types run build && corepack pnpm --dir apps/api exec jest --testPathIgnorePatterns=integration --testPathIgnorePatterns=upload --passWithNoTests && corepack pnpm --dir apps/web exec jest --passWithNoTests",
    "check:braces-patch": "node scripts/check-braces-patch.cjs",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "corepack pnpm --dir apps/api run test:integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "corepack pnpm test && corepack pnpm test:integration && corepack pnpm test:e2e",
    "lint": "corepack pnpm --dir apps/api exec eslint src --ext .ts && corepack pnpm --dir apps/web exec next lint",
    "typecheck": "corepack pnpm --dir packages/shared-types run build && corepack pnpm exec tsc --noEmit -p apps/api/tsconfig.json && corepack pnpm --dir apps/web exec next typegen . && corepack pnpm exec tsc --noEmit --incremental false -p apps/web/tsconfig.json",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:migrate": "pnpm --filter @aether/api db:migrate",
    "db:seed": "pnpm --filter @aether/api db:seed",
    "db:studio": "pnpm --filter @aether/api db:studio",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.1",
    "turbo": "^2.10.0",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "overrides": {
      "path-to-regexp@<0.1.13": "0.1.13",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "socket.io-parser@<4.2.7": "4.2.7",
      "engine.io@<6.6.10": "6.6.10",
      "body-parser@<1.20.6": "1.20.6",
      "ws@<8.21.0": "8.21.0",
      "tmp@<0.2.6": "0.2.6",
      "markdown-it@<14.3.1": "14.3.1",
      "linkify-it@<5.0.2": "5.0.2",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.0.2": "2.0.2",
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "browserslist@<4.28.7": "4.28.7",
      "baseline-browser-mapping@<2.11.0": "2.11.0",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=4.0.0 <5.1.7": "5.1.7",
      "minimatch@>=6.0.0 <9.0.7": "9.0.7",
      "serialize-javascript@<6.0.2": "6.0.2",
      "flatted@<3.4.2": "3.4.2",
      "uuid@<9.0.1": "9.0.1",
      "qs@>=6.11.1 <6.16.0": "6.16.0",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=3.0.0 <4.0.4": "4.0.4",
      "postcss@<8.5.23": "8.5.23",
      "postcss-selector-parser@<7.1.6": "7.1.6",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "source-map-js@<1.2.2": "1.2.2",
      "prosemirror-view@<1.42.3": "1.42.3",
      "sharp@<0.35.5": "0.35.5",
      "proxy-addr@<2.0.8": "2.0.8",
      "ajv@<6.14.0": "6.14.0",
      "fast-xml-parser@<5.7.0": "5.7.0",
      "fast-xml-builder@<1.1.7": "1.1.7",
      "@tiptap/extension-link@<2.10.4": "2.10.4",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "handlebars@<=4.7.9": "4.7.10",
      "ip-address@<10.7.1": "10.7.1",
      "tmp@<0.2.7": "0.2.7",
      "@babel/core@<7.29.6": "7.29.6",
      "js-yaml@<3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "@istanbuljs/load-nyc-config>js-yaml": "4.3.2"
    },
    "patchedDependencies": {
      "braces@3.0.3": "patches/braces@3.0.3.patch"
    }
  },
  "packageManager": "pnpm@8.12.0"
}
