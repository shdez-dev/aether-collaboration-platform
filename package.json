{
  "name": "aether",
  "version": "0.1.0",
  "private": true,
  "description": "Adaptive Event-driven Trusted Human-Environment for Real-time collaboration",
  "author": "Your Name",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "turbo run test:integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "pnpm test && pnpm test:integration && pnpm test:e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:migrate": "pnpm --filter @aether/api db:migrate",
    "db:seed": "pnpm --filter @aether/api db:seed",
    "db:studio": "pnpm --filter @aether/api db:studio",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.1",
    "turbo": "^2.10.0",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "overrides": {
      "path-to-regexp@<0.1.13": "0.1.13",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "socket.io-parser@<4.2.6": "4.2.6",
      "ws@<8.21.0": "8.21.0",
      "tmp@<0.2.6": "0.2.6",
      "markdown-it@<14.2.0": "14.2.0",
      "brace-expansion@<1.1.13": "1.1.13",
      "brace-expansion@>=2.0.0 <2.0.2": "2.0.2",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=4.0.0 <5.1.7": "5.1.7",
      "minimatch@>=6.0.0 <9.0.7": "9.0.7",
      "serialize-javascript@<6.0.2": "6.0.2",
      "flatted@<3.4.2": "3.4.2",
      "uuid@<9.0.1": "9.0.1",
      "qs@>=6.11.1 <=6.15.1": "6.15.2",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=3.0.0 <4.0.4": "4.0.4",
      "postcss@<8.5.10": "8.5.10",
      "ajv@<6.14.0": "6.14.0",
      "fast-xml-parser@<5.7.0": "5.7.0",
      "fast-xml-builder@<1.1.7": "1.1.7",
      "@tiptap/extension-link@<2.10.4": "2.10.4",
      "basic-ftp@<=5.3.0": "5.3.1",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "handlebars@<=4.7.8": "4.7.9",
      "ip-address@<=10.1.0": "10.1.1",
      "tmp@<0.2.7": "0.2.7",
      "@babel/core@<7.29.6": "7.29.6"
    }
  },
  "packageManager": "pnpm@8.12.0"
}
