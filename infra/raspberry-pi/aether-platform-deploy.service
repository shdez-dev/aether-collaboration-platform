[Unit]
Description=Actualizar Aether desde la rama principal
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=athe
Group=athe
WorkingDirectory=/home/athe/aether-collaboration-platform
ExecStart=/home/athe/aether-collaboration-platform/infra/raspberry-pi/deploy.sh --update
Nice=10
